# Google Gemini API key (required)
GEMINI_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Tiger Data connection string, including the password (optional; enables report caching)
DATABASE_URL=
# Postgres schema for this environment: leave unset in production, dev locally (previews use staging)
DB_SCHEMA=dev
# Google sign-in (optional; the Sign in button is hidden without both)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SEC asks for a contact in the User-Agent
SEC_USER_AGENT=SignalWatch/1.0 (contact@signalwatch.xyz)
